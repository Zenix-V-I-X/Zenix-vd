local originalMakeTab = Library.MakeTab
function Library:MakeTab(config)
	local tab = originalMakeTab(self, config)
	tab._page = nil
	local function detectPage(element)
		if tab._page then return end
		if element and element.Parent and element.Parent:IsA("ScrollingFrame") then
			tab._page = element.Parent
			local function refresh()
				if tab._page and tab._page.Parent then
					local uiList = tab._page:FindFirstChildOfClass("UIListLayout")
					if uiList then
						tab._page.CanvasSize = UDim2.new(0, 0, 0, uiList.AbsoluteContentSize.Y + 60)
					end
				end
			end
			tab._page:GetPropertyChangedSignal("Parent"):Connect(function() task.delay(0.2, refresh) end)
			task.delay(0.5, refresh)
			task.delay(1.5, refresh)
		end
	end
	local origAddButton = tab.AddButton
	function tab:AddButton(cfg)
		local btn = origAddButton(self, cfg)
		detectPage(btn)
		return btn
	end
	local origToggle = tab.AddToggle
	function tab:AddToggle(cfg)
		if cfg.Title and not cfg[1] then cfg = { cfg.Title, cfg.Default or false, Callback = cfg.Callback } end
		local before = {}
		if tab._page then for _, c in ipairs(tab._page:GetChildren()) do before[c] = true end end
		local result = origToggle(self, cfg)
		if tab._page and result then
			for _, c in ipairs(tab._page:GetChildren()) do
				if not before[c] and c:IsA("TextButton") then result.Frame = c; break end
			end
		end
		if not tab._page and result and result.Frame then detectPage(result.Frame) end
		return result
	end
	local origSlider = tab.AddSlider
	function tab:AddSlider(cfg)
		if cfg.Title and not cfg[1] then cfg = { cfg.Title, cfg.Min or 0, cfg.Max or 100, nil, cfg.Default or 50, Callback = cfg.Callback } end
		local result = origSlider(self, cfg)
		detectPage(result)
		return result
	end
	local origTextBox = tab.AddTextBox
	function tab:AddTextBox(cfg)
		if cfg.Title and not cfg[1] then cfg = { cfg.Title, cfg.Default or "", cfg.PlaceholderText or cfg.Placeholder, Callback = cfg.Callback } end
		local result = origTextBox(self, cfg)
		detectPage(result)
		return result
	end
	return tab
end

