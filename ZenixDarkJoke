local countdowns = {}
local function createCountdown(btn)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.Position = UDim2.new(0, 0, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = ""
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.FontFace = Font.new("rbxassetid://12187360881")
	lbl.TextSize = 18
	lbl.TextStrokeTransparency = 0.3
	lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	lbl.ZIndex = 30
	lbl.Visible = false
	lbl.Parent = btn
	local state = { value = 60, max = 60, active = false, label = lbl }
	table.insert(countdowns, state)
	return state
end
local function startCountdown(state)
	state.value = state.max
	state.active = true
	if state.label then
		state.label.Text = tostring(state.value)
		state.label.Visible = true
	end
end
task.spawn(function()
	while task.wait(1) do
		for _, state in ipairs(countdowns) do
			if state.active then
				state.value = state.value - 1
				if state.value <= 0 then
					state.active = false
					if state.label then
						state.label.Text = ""
						state.label.Visible = false
					end
				else
					if state.label then state.label.Text = tostring(state.value) end
				end
			end
		end
	end
end)

