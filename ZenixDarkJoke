local function isValidSongId(id)
	if not id then return false end
	local s = tostring(id):gsub("%s", "")
	if s == "" then return false end
	if not s:match("^%d+$") then return false end
	return true
end
local function canPlaySong(id)
	if not isValidSongId(id) then return false end
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(id)
	local ok = pcall(function() ContentProvider:PreloadAsync({sound}) end)
	local isLoaded = sound.IsLoaded
	sound:Destroy()
	return ok and isLoaded
end

