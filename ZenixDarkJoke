local function makeMethodToggle(label, mode)
	local t
	t = PropsRobotsTab:AddToggle({ label, false, Callback = function(state)
		if suppressCb then return end
		if state then
			local targets = resolveTargets()
			if #targets == 0 then
				if t and t.SetToggle then pcall(function() t.SetToggle(false) end) end
				return
			end
			startBangOnTargets(mode, targets, t)
		else
			if activeMode == mode then stopActiveBang() end
		end
	end })
	allToggles[mode] = t
end
