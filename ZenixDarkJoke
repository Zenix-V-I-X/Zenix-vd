local function computeCFrame(mode, i, total, hrp, timer)
	if mode == "back" then
		local offset = backOffsets[i] or Vector3.new(0, 0.5, 1.8)
		local retreat = (math.sin(timer * 27 + (i * 0.3)) + 1) * 1.5
		local localPos = Vector3.new(offset.X, offset.Y, offset.Z + retreat)
		local worldPos = hrp.CFrame:PointToWorldSpace(localPos)
		return CFrame.new(worldPos, hrp.Position + Vector3.new(0, offset.Y, 0)) * CFrame.Angles(0, math.rad(180), 0)
	elseif mode == "face" then
		local offset = faceOffsets[i] or Vector3.new(0, 0.5, -1.8)
		local retreat = (math.sin(timer * 27 + (i * 0.3)) + 1) * 1.5
		local localPos = Vector3.new(offset.X, offset.Y, offset.Z - retreat)
		local worldPos = hrp.CFrame:PointToWorldSpace(localPos)
		return CFrame.new(worldPos, hrp.Position + Vector3.new(0, offset.Y, 0)) * CFrame.Angles(0, math.rad(180), 0)
	elseif mode == "combined" then
		local isBack = (i % 2 == 0)
		local idx = math.ceil(i / 2)
		if isBack then
			local offset = backOffsets[idx] or Vector3.new(0, 0.5, 1.8)
			local retreat = (math.sin(timer * 27 + (i * 0.3)) + 1) * 1.5
			local localPos = Vector3.new(offset.X, offset.Y, offset.Z + retreat)
			local worldPos = hrp.CFrame:PointToWorldSpace(localPos)
			return CFrame.new(worldPos, hrp.Position + Vector3.new(0, offset.Y, 0)) * CFrame.Angles(0, math.rad(180), 0)
		else
			local offset = faceOffsets[idx] or Vector3.new(0, 0.5, -1.8)
			local retreat = (math.sin(timer * 27 + (i * 0.3)) + 1) * 1.5
			local localPos = Vector3.new(offset.X, offset.Y, offset.Z - retreat)
			local worldPos = hrp.CFrame:PointToWorldSpace(localPos)
			return CFrame.new(worldPos, hrp.Position + Vector3.new(0, offset.Y, 0)) * CFrame.Angles(0, math.rad(180), 0)
		end
	elseif mode == "circle" then
		local angle = (i / total) * math.pi * 2
		local retreat = math.sin(timer * 3 + (i * 0.3)) * 7.5 - 7.5
		local radius = 2.8 + retreat
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		local currentPos = hrp.Position + Vector3.new(x, -0.2, z)
		local lookAtPos = Vector3.new(hrp.Position.X, currentPos.Y, hrp.Position.Z)
		return CFrame.new(currentPos, lookAtPos) * CFrame.Angles(0, math.rad(180), 0)
	elseif mode == "circleOut" then
		local angle = (i / total) * math.pi * 2
		local bangDistance = (math.sin(timer * 3 + (i * 0.2)) * 20) + 20
		local radius = 3 + bangDistance
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		local currentPos = hrp.Position + Vector3.new(x, 0, z)
		local lookAwayPos = currentPos + Vector3.new(x, 0, z)
		return CFrame.new(currentPos, lookAwayPos) * CFrame.Angles(0, math.rad(180), 0)
	elseif mode == "lineFront" then
		local spacing = 2.5
		local offsetX = (i - (total + 1) / 2) * spacing
		local bangDistance = (math.sin(timer * 3 + (i * 0.1)) * 20) - 20
		local localPos = Vector3.new(offsetX, 0, -3 + bangDistance)
		local worldPos = hrp.CFrame:PointToWorldSpace(localPos)
		local forwardLook = worldPos + (hrp.CFrame.LookVector * -10)
		return CFrame.new(worldPos, forwardLook) * CFrame.Angles(0, math.rad(180), 0)
	elseif mode == "spin" then
		local angle = (i / total) * math.pi * 2 + (tick() * 7)
		local radius = 4.5
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		local currentPos = hrp.Position + Vector3.new(x, 0.2, z)
		local lookAtPos = Vector3.new(hrp.Position.X, currentPos.Y, hrp.Position.Z)
		return CFrame.new(currentPos, lookAtPos) * CFrame.Angles(0, math.rad(180), 0)
	elseif mode == "war" then
		local pairIndex = math.ceil(i / 2)
		local totalPairs = math.max(1, math.ceil(total / 2))
		local angle = (pairIndex / totalPairs) * math.pi * 2
		local pairCenter = hrp.Position + Vector3.new(math.cos(angle) * 5.5, 0.5, math.sin(angle) * 5.5)
		local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
		local isFirst = (i % 2 == 1)
		local posA = pairCenter + tangent * 1.2
		local posB = pairCenter - tangent * 1.2
		local shake = Vector3.new(math.random(-25, 25) / 10, math.random(-25, 25) / 10, math.random(-25, 25) / 10)
		if isFirst then
			return CFrame.new(posA + shake, posB) * CFrame.Angles(0, math.rad(180), 0)
		else
			return CFrame.new(posB + shake, posA) * CFrame.Angles(0, math.rad(180), 0)
		end
	elseif mode == "fling" then
		local rx = math.random(-15, 15)
		local ry = math.random(-10, 15)
		local rz = math.random(-15, 15)
		local currentPos = hrp.Position + Vector3.new(rx, ry, rz)
		return CFrame.new(currentPos) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
	end
	return nil
end

