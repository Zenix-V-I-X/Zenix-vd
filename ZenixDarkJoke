local originalMakeTab = Library.MakeTab
local _zenixTabsCreated = 0
function Library:MakeTab(config)
	local ok, tab = pcall(function()
		return originalMakeTab(self, config)
	end)
	if not ok or not tab then
		warn("[Zenix] MakeTab failed:", config and config.Title, tab)
		-- dummy so script continues
		local dummy = {}
		function dummy:AddButton() return nil end
		function dummy:AddToggle() return { SetToggle = function() end } end
		function dummy:AddSlider() return nil end
		function dummy:AddTextBox() return nil end
		function dummy:AddDropdown() return { Refresh = function() end } end
		return dummy
	end
	_zenixTabsCreated = _zenixTabsCreated + 1
	tab._page = nil
	local function detectPage(element)
		if tab._page then return end
		if element and element.Parent and element.Parent:IsA("ScrollingFrame") then
			tab._page = element.Parent
			local function refresh()
				if tab._page and tab._page.Parent then
					local uiList = tab._page:FindFirstChildOfClass("UIListLayout")
					if uiList then
						tab._page.CanvasSize = UDim2.new(0, 0, 0, uiList.AbsoluteContentSize.Y + 60)
					end
				end
			end
			tab._page:GetPropertyChangedSignal("Parent"):Connect(function() task.delay(0.2, refresh) end)
			task.delay(0.5, refresh)
			task.delay(1.5, refresh)
		end
	end
	local origAddButton = tab.AddButton
	function tab:AddButton(cfg)
		local ok2, btn = pcall(function() return origAddButton(self, cfg) end)
		if ok2 and btn then detectPage(btn) end
		return ok2 and btn or nil
	end
	local origToggle = tab.AddToggle
	function tab:AddToggle(cfg)
		if type(cfg) == "table" and cfg.Title and not cfg[1] then
			cfg = { cfg.Title, cfg.Default or false, Callback = cfg.Callback }
		end
		local before = {}
		if tab._page then for _, c in ipairs(tab._page:GetChildren()) do before[c] = true end end
		local ok2, result = pcall(function() return origToggle(self, cfg) end)
		if not ok2 then warn("[Zenix] AddToggle fail", cfg and (cfg[1] or cfg.Title), result); return { SetToggle = function() end } end
		if tab._page and result then
			for _, c in ipairs(tab._page:GetChildren()) do
				if not before[c] and c:IsA("TextButton") then result.Frame = c; break end
			end
		end
		if not tab._page and result and result.Frame then detectPage(result.Frame) end
		return result
	end
	local origSlider = tab.AddSlider
	function tab:AddSlider(cfg)
		if type(cfg) == "table" and cfg.Title and not cfg[1] then
			cfg = { cfg.Title, cfg.Min or 0, cfg.Max or 100, nil, cfg.Default or 50, Callback = cfg.Callback }
		end
		local ok2, result = pcall(function() return origSlider(self, cfg) end)
		if ok2 then detectPage(result) end
		return ok2 and result or nil
	end
	local origTextBox = tab.AddTextBox
	function tab:AddTextBox(cfg)
		if type(cfg) == "table" and cfg.Title and not cfg[1] then
			cfg = { cfg.Title, cfg.Default or "", Placeholder = cfg.PlaceholderText or cfg.Placeholder, Callback = cfg.Callback }
		elseif type(cfg) == "table" and cfg[1] and cfg[3] and not cfg.Placeholder then
			cfg.Placeholder = cfg[3]
		end
		local ok2, result = pcall(function() return origTextBox(self, cfg) end)
		if ok2 then detectPage(result) end
		return ok2 and result or nil
	end
	local origDropdown = tab.AddDropdown
	if origDropdown then
		function tab:AddDropdown(cfg)
			local ok2, result = pcall(function() return origDropdown(self, cfg) end)
			if ok2 then detectPage(result) end
			return ok2 and result or { Refresh = function() end }
		end
	end
	return tab
end

return tab
end

