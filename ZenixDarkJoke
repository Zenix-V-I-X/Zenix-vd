local activeMode, activeConn, activeSpawnTask = nil, nil, nil
local suppressCb = false
local allToggles = {}
local function stopActiveBang()
	activeMode = nil
	if activeConn then pcall(function() activeConn:Disconnect() end); activeConn = nil end
	if activeSpawnTask then pcall(function() task.cancel(activeSpawnTask) end); activeSpawnTask = nil end
end
local function resetOtherToggles(keep)
	suppressCb = true
	for mode, t in pairs(allToggles) do
		if t ~= keep and t and t.SetToggle then pcall(function() t.SetToggle(false) end) end
	end
	suppressCb = false
end
local function startBangOnTargets(mode, targets, toggleObj)
	stopActiveBang()
	resetOtherToggles(toggleObj)
	activeMode = mode
	activeSpawnTask = task.spawn(function()
		local perTarget = math.max(2, math.floor(fixedVictimCount / #targets))
		if hasVIP then perTarget = math.max(perTarget, 3) end
		if mode == "combined" then perTarget = perTarget * 2 end
		local needed = perTarget * #targets
		local existing = GetMyBots()
		local toSpawn = needed - #existing
		if toSpawn > 0 then
			for _ = 1, toSpawn do
				if activeMode ~= mode then return end
				spawnOneProp(selectedProp)
			end
		end
		local timer = 0
		activeConn = RunService.Heartbeat:Connect(function(dt)
			if activeMode ~= mode then
				if activeConn then activeConn:Disconnect(); activeConn = nil end
				return
			end
			local validTargets = {}
			for _, p in ipairs(targets) do
				if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					table.insert(validTargets, p)
				end
			end
			if #validTargets == 0 then return end
			timer = timer + dt * 10
			local bots = GetMyBots()
			if #bots == 0 then return end
			for i, bot in ipairs(bots) do
				local setCF = bot:FindFirstChild("SetCurrentCFrame")
				if setCF then
					local targetIdx = ((i - 1) % #validTargets) + 1
					local tPlayer = validTargets[targetIdx]
					local hrp = tPlayer.Character.HumanoidRootPart
					local subIdx = math.floor((i - 1) / #validTargets) + 1
					local subTotal = math.ceil(#bots / #validTargets)
					local newCF = computeCFrame(mode, subIdx, subTotal, hrp, timer)
					if newCF then pcall(function() setCF:InvokeServer(newCF) end) end
				end
			end
		end)
	end)
end
