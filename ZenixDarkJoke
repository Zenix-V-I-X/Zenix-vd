local function GetPlayerMatch(name)
	if not name or name == "" then return nil end
	local target = nil
	for _, player in pairs(Players:GetPlayers()) do
		if string.sub(string.lower(player.Name), 1, string.len(name)) == string.lower(name) or
			string.sub(string.lower(player.DisplayName), 1, string.len(name)) == string.lower(name) then
			target = player
			break
		end
	end
	return target
end
local function SecureAction(actionFunc, verifyFunc)
	for _ = 1, 7 do
		actionFunc()
		task.wait(0.25)
		if verifyFunc() then return true end
	end
	return false
end
local function IsAccessoryEquipped(assetId)
	local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	local d = hum:GetAppliedDescription()
	for _, a in ipairs(d:GetAccessories(true)) do
		if tonumber(a.AssetId) == tonumber(assetId) then return true end
	end
	return false
end
local function ClearAccessoriesByType(accType)
	local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local d = hum:GetAppliedDescription()
	for _, a in ipairs(d:GetAccessories(true)) do
		if a.AccessoryType == accType then
			SecureAction(function() ReplicatedStorage.Remotes.Wear:InvokeServer(tonumber(a.AssetId)) end, function() return not IsAccessoryEquipped(a.AssetId) end)
		end
	end
end
local function ClearAllClothingAndAccs()
	local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local d = hum:GetAppliedDescription()
	for _, a in ipairs(d:GetAccessories(true)) do
		SecureAction(function() ReplicatedStorage.Remotes.Wear:InvokeServer(tonumber(a.AssetId)) end, function() return not IsAccessoryEquipped(a.AssetId) end)
	end
	SecureAction(function() ReplicatedStorage.Remotes.Wear:InvokeServer(0) end, function()
		local currentD = Player.Character:FindFirstChildOfClass("Humanoid"):GetAppliedDescription()
		return currentD.Shirt == 0 and currentD.Pants == 0 and #currentD:GetAccessories(true) == 0
	end)
end
local function CopySpecificAccessory(target, accType)
	if not target or not target.Character then return end
	ClearAccessoriesByType(accType)
	local pD = target.Character:FindFirstChildOfClass("Humanoid"):GetAppliedDescription()
	for _, a in ipairs(pD:GetAccessories(true)) do
		if a.AccessoryType == accType then
			SecureAction(function() ReplicatedStorage.Remotes.Wear:InvokeServer(tonumber(a.AssetId)) end, function() return IsAccessoryEquipped(a.AssetId) end)
		end
	end
end
