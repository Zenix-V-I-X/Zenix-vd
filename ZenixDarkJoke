local rpLabel, bioLabel = nil, nil
local lastRP, lastBio = nil, nil
local rpBioInitialized = false

local function findBillboardLabels()
	local char = LocalPlayer.Character
	if not char then return nil end
	local labels = {}
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("TextLabel") then
			local p = desc
			local isBB = false
			for _ = 1, 10 do
				p = p.Parent
				if not p then break end
				if p:IsA("BillboardGui") then isBB = true; break end
			end
			if isBB then table.insert(labels, desc) end
		end
	end
	table.sort(labels, function(a, b) return (a.TextSize or 0) > (b.TextSize or 0) end)
	return labels
end

task.spawn(function()
	while task.wait(0.25) do
		local labels = findBillboardLabels()
		if not labels or #labels == 0 then
			rpLabel, bioLabel = nil, nil
			lastRP, lastBio = nil, nil
			rpBioInitialized = false
		else
			if not rpLabel or not rpLabel.Parent then
				rpLabel = labels[1]
				lastRP = rpLabel and rpLabel.Text or nil
			end
			if not bioLabel or not bioLabel.Parent then
				if #labels >= 2 then
					bioLabel = labels[2]
					lastBio = bioLabel and bioLabel.Text or nil
				end
			end
			if rpLabel and rpLabel.Parent then
				if rpBioInitialized and lastRP ~= nil and rpLabel.Text ~= lastRP then
					lastRP = rpLabel.Text
					startCountdown(rpCountdown)
				else
					lastRP = rpLabel.Text
				end
			end
			if bioLabel and bioLabel.Parent then
				if rpBioInitialized and lastBio ~= nil and bioLabel.Text ~= lastBio then
					lastBio = bioLabel.Text
					startCountdown(bioCountdown)
				else
					lastBio = bioLabel.Text
				end
			end
			rpBioInitialized = true
		end
	end
end)

