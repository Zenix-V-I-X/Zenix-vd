local function computeMoveShape(mode, i, total, h, cycleTime)
	local lookDir = h.CFrame.LookVector
	local rightDir = h.CFrame.RightVector
	if mode == "basic" then
		local angle = (i / total) * math.pi * 2 + cycleTime
		return h.CFrame * CFrame.new(math.cos(angle) * moveDistance, 0, math.sin(angle) * moveDistance)
	elseif mode == "ذيل قرش" then
		local offset = (i - 1) * 1.5
		local swing = math.sin(cycleTime + i * 0.5) * (moveDistance * 0.2)
		return h.CFrame * CFrame.new(swing, 0, 2 + offset + (moveDistance * 0.1))
	elseif mode == "جناحات" then
		local s = (i % 2 == 0) and 1 or -1
		local l = math.ceil(i / 2)
		return h.CFrame * CFrame.new(s * (1 + l * 0.5) * (moveDistance / 5), l * 0.3, 1) * CFrame.Angles(0, math.rad(s * 30) + math.sin(cycleTime) * 0.2, math.rad(s * 15))
	elseif mode == "جناحات مختلفه" then
		local s = (i % 2 == 0) and 1 or -1
		local l = math.ceil(i / 2)
		local flap = math.sin(cycleTime) * 0.8 + math.sin(cycleTime * 2) * 0.3
		return h.CFrame * CFrame.new(s * (1 + l * 0.5) * (moveDistance / 5), l * 0.3 + flap * (1 + l * 0.15), 1) * CFrame.Angles(math.rad(flap * 25), math.rad(s * 30), math.rad(s * 15 + flap * 12.5))
	elseif mode == "اعصار صغير" then
		local angle = i * 1.5 + cycleTime
		local radius = (1 + i * 0.4) * (moveDistance / 5)
		return h.CFrame * CFrame.new(math.cos(angle) * radius, i * 0.8 - 2, math.sin(angle) * radius)
	elseif mode == "orbit" then
		local angle = (i / total) * math.pi * 2 + cycleTime
		return h.CFrame * CFrame.new(math.cos(angle) * moveDistance, math.sin(cycleTime) * 0.5, math.sin(angle) * moveDistance)
	elseif mode == "حبل" then
		local angle = (i / total) * math.pi * 2 + cycleTime
		local radius = (4 + i * 0.8) * (moveDistance / 5)
		return h.CFrame * CFrame.new(math.cos(angle) * radius, i * 0.8 - 2, math.sin(angle) * radius) * CFrame.Angles(0, -angle + math.pi / 2, math.rad(15))
	elseif mode == "ني* قدامك" then
		return CFrame.new(h.Position + lookDir * moveDistance + Vector3.new(0, -2 + math.sin(cycleTime) * 1.5 + ((i - 1) * 3), 0)) * CFrame.Angles(0, math.rad(h.Orientation.Y + 180), 0)
	elseif mode == "ذيل" then
		return CFrame.new(h.Position - lookDir * (moveDistance + (i - 1) * 3) + Vector3.new(0, -2 + math.sin(cycleTime), 0)) * CFrame.Angles(0, math.rad(h.Orientation.Y + 180), 0)
	elseif mode == "ز*" then
		return CFrame.new(h.Position + lookDir * (moveDistance + (i - 1) * 3) + Vector3.new(0, -2 + math.sin(cycleTime), 0)) * CFrame.Angles(0, math.rad(h.Orientation.Y), 0)
	elseif mode == "اكس خلف الاعب" then
		local half = math.ceil(total / 2)
		local scale = (moveDistance / 5) * 2.5
		local anim = math.sin(cycleTime) * 0.6
		local offsetZ = 3 + (moveDistance * 0.2)
		if i <= half then
			local step = (i - (half + 1) / 2) * scale
			return h.CFrame * CFrame.new(step, step + anim, offsetZ)
		else
			local idx = i - half
			local step = (idx - (half + 1) / 2) * scale
			return h.CFrame * CFrame.new(step, -step + anim, offsetZ)
		end
	elseif mode == "دائره خلف الاعب" then
		local angle = (i / total) * math.pi * 2 + cycleTime
		return h.CFrame * CFrame.new(math.cos(angle) * moveDistance, math.sin(angle) * moveDistance, 3) * CFrame.Angles(0, 0, angle)
	elseif mode == "مربع خلف الاعب" then
		local sideCount = math.max(1, math.floor(total / 4))
		local side = math.floor((i - 1) / sideCount) % 4
		local idx = (i - 1) % sideCount
		local size = moveDistance
		local step = (idx / math.max(1, sideCount - 1) - 0.5) * size
		local anim = math.sin(cycleTime + i) * 0.5
		local px, py = 0, 0
		if side == 0 then px = step; py = size / 2
		elseif side == 1 then px = size / 2; py = -step
		elseif side == 2 then px = -step; py = -size / 2
		else px = -size / 2; py = step end
		return h.CFrame * CFrame.new(px, py + anim, 3)
	elseif mode == "عشوائي بلارض" then
		if not landPositions[i] then
			landPositions[i] = {x = math.random(-35, 35), z = math.random(-35, 35)}
		end
		local lp = landPositions[i]
		local bob = math.sin(cycleTime + i * 1.7) * 0.5
		return CFrame.new(h.Position + rightDir * (lp.x * (moveDistance / 10)) + lookDir * (lp.z * (moveDistance / 10)) + Vector3.new(0, -1 + bob, 0))
	elseif mode == "يد واصبع" then
		if i <= 4 then
			return CFrame.new(h.Position + rightDir * moveDistance + Vector3.new(0, 13 + (i - 1) * 3 + math.sin(cycleTime) * 1.5, 0))
		elseif i <= 9 then
			return CFrame.new(h.Position + rightDir * (((i - 4) * 3) * (moveDistance / 5)) + Vector3.new(0, 10, 0))
		elseif i <= 12 then
			return CFrame.new(h.Position + rightDir * ((3 + (i - 9) * 3) * (moveDistance / 5)) + Vector3.new(0, 7, 0))
		else
			return CFrame.new(h.Position + rightDir * ((3 + (i - 12) * 3) * (moveDistance / 5)) + Vector3.new(0, 4, 0))
		end
	elseif mode == "ز* 67" then
		if i == 1 then
			return CFrame.new(h.Position + lookDir * moveDistance + Vector3.new(0, -3, 0))
		elseif i <= 3 then
			local s = (i == 2) and -1 or 1
			return CFrame.new(h.Position + lookDir * moveDistance + rightDir * (s * 2) + Vector3.new(0, -5, 0))
		else
			return CFrame.new(h.Position + lookDir * (moveDistance + (i - 3) * 2) + Vector3.new(0, -3, 0))
		end
	end
	return nil
end

