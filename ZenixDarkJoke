local function findPlayerByText(txt)
	if txt == "" or txt == "على نفسك" or txt == "على نفسي" or txt == "self" or txt == "نفسي" then
		return LocalPlayer
	end
	local lowerText = string.lower(txt)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == lowerText or string.lower(p.DisplayName) == lowerText then return p end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(p.Name), lowerText, 1, true) or string.find(string.lower(p.DisplayName), lowerText, 1, true) then return p end
	end
	return nil
end
local function resolveTargets()
	local list = {}
	local seen = {}
	for i = 1, 10 do
		local txt = targetNames[i]
		if txt and txt ~= "" then
			local plr = findPlayerByText(txt)
			if plr and not seen[plr] then
				seen[plr] = true
				table.insert(list, plr)
			end
		end
	end
	if #list == 0 then table.insert(list, LocalPlayer) end
	return list
end
