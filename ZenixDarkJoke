local rpNameLabelRef, bioLabelRef = nil, nil
local lastRPText, lastBioText = "", ""

local function findBillboardLabels()
	rpNameLabelRef = nil
	bioLabelRef = nil
	local char = LocalPlayer.Character
	if not char then return end
	local texts = {}
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Text ~= "..." then
			local p = desc.Parent
			local depth = 0
			while p and depth < 6 do
				if p:IsA("BillboardGui") then
					table.insert(texts, desc)
					break
				end
				p = p.Parent
				depth = depth + 1
			end
		end
	end
	if #texts >= 2 then
		table.sort(texts, function(a, b) return a.TextSize > b.TextSize end)
		rpNameLabelRef = texts[1]
		bioLabelRef = texts[2]
		lastRPText = rpNameLabelRef.Text
		lastBioText = bioLabelRef.Text
	elseif #texts == 1 then
		rpNameLabelRef = texts[1]
		lastRPText = rpNameLabelRef.Text
	end
end

task.spawn(function()
	while task.wait(0.5) do
		local char = LocalPlayer.Character
		if not char then
			rpNameLabelRef = nil
			bioLabelRef = nil
		else
			if not rpNameLabelRef or not rpNameLabelRef.Parent then
				findBillboardLabels()
			end
			if rpNameLabelRef and rpNameLabelRef.Parent then
				if rpNameLabelRef.Text ~= lastRPText then
					lastRPText = rpNameLabelRef.Text
					startRPTimer()
				end
			end
			if bioLabelRef and bioLabelRef.Parent then
				if bioLabelRef.Text ~= lastBioText then
					lastBioText = bioLabelRef.Text
					startBioTimer()
				end
			end
		end
	end
end)

