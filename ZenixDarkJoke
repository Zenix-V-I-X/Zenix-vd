local function equipTool(name)
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local tool = LocalPlayer.Backpack:WaitForChild(name, 2)
	if tool then
		tool.Parent = char
		hum:EquipTool(tool)
	end
	return tool
end
